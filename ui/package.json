{
  "name": "carmine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Coral-Book の数式を読みながら金融モデルをブラウザで動かす教材（初版：円OISカーブと7年OIS）",
  "scripts": {
    "dev": "node scripts/check-port.mjs 8081 && vite",
    "api": "node scripts/run-r.mjs ../server/server.R --port 8787",
    "build": "tsc -b && vite build",
    "preview": "node scripts/check-port.mjs 8081 && vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "golden": "node scripts/run-r.mjs ../server/tests/golden/generate_golden.R",
    "reconcile": "node scripts/run-r.mjs ../server/tests/reconciliation/reconcile_tona_ois.R",
    "lan": "npm run build && node scripts/check-port.mjs 8081 0.0.0.0 && node scripts/run-r.mjs ../server/server.R --host 0.0.0.0 --port 8081 --static dist",
    "reconcile:prdc-risk": "node scripts/run-r.mjs ../server/tests/reconciliation/prdc_risk/reconcile_prdc_risk.R",
    "reconcile:parallel": "node scripts/run-r.mjs ../server/tests/reconciliation/parallel/reconcile_parallel.R",
    "reconcile:prdc": "node scripts/run-r.mjs ../server/tests/reconciliation/prdc/reconcile_prdc.R",
    "reconcile:p16": "node scripts/run-r.mjs ../server/tests/reconciliation/p16/reconcile_p16.R",
    "reconcile:mbs-prdc": "node scripts/run-r.mjs ../server/tests/reconciliation/mbs_prdc/reconcile_mbs_prdc.R",
    "reconcile:bs-surrogate": "node scripts/run-r.mjs ../server/tests/reconciliation/cnn_bs/reconcile_bs_surrogate.R",
    "reconcile:callable": "node scripts/run-r.mjs ../server/tests/reconciliation/callable/reconcile_callable.R",
    "reconcile:rate-models": "node scripts/run-r.mjs ../server/tests/reconciliation/rate_models/reconcile_rate_models.R",
    "reconcile:calibration": "node scripts/run-r.mjs ../server/tests/reconciliation/calibration/reconcile_calibration.R",
    "reconcile:bond": "node scripts/run-r.mjs ../server/tests/reconciliation/bond/reconcile_bond.R",
    "reconcile:black": "node scripts/run-r.mjs ../server/tests/reconciliation/black/reconcile_black.R",
    "reconcile:cds": "node scripts/run-r.mjs ../server/tests/reconciliation/cds/reconcile_cds.R",
    "reconcile:asw": "node scripts/run-r.mjs ../server/tests/reconciliation/asw/reconcile_asw_jpy.R && node scripts/run-r.mjs ../server/tests/reconciliation/asw/reconcile_yen_asw.R",
    "snapshot:asw": "node scripts/run-r.mjs ../server/scripts/asw/snapshot_curie_demo.R"
  },
  "dependencies": {
    "katex": "0.19.1",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@mdx-js/rollup": "3.1.1",
    "@types/mdx": "2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
